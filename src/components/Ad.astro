---
/**
 * A placed AdSense unit, labelled and with its space reserved so the page does not jump.
 * The ad unit id is `unit`, never `slot`: on a direct child of a layout Astro reads `slot="…"` as a
 * named slot and silently drops the whole component (the in-content ad was missing for that reason).
 */
interface Props {
  unit?: string;
  kind?: 'wide' | 'rail' | 'mid' | 'lead';
}

// Headway's own units (12 Nov 2026): Headway In-content 8619321960 sits after the timetable;
// Headway Bottom 7026717897 everywhere else. Its reports no longer mix with Stopwatch's.
const BOTTOM = '7026717897';
const { unit = BOTTOM, kind = 'wide' } = Astro.props;
const CLIENT = 'ca-pub-7164999486301748';
---
<aside class:list={['ad', `ad-${kind}`]} aria-label="Advertisement">
  <span class="ad-label">Advertisement</span>
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client={CLIENT}
    data-ad-slot={unit}
    data-ad-format={kind === 'rail' ? 'vertical' : 'auto'}
    data-full-width-responsive={kind === 'rail' ? 'false' : 'true'}
  ></ins>
</aside>

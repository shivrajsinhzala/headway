---
import '@fontsource-variable/sora/wght.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { SITE, inNetwork, systems } from '../lib/site.js';

const { title, description, path = '', noindex = false, jsonld = [], operator = '', nav = false, ogType = 'website', modified, pageType = 'WebPage' } = Astro.props;
const canonical = `${SITE}${path === '/' ? '/' : path}`;
// Australian pages are en-AU and Phoenix en-US: search engines and assistants use it to match a reader's region.
const lang = path.startsWith('/au') ? 'en-AU' : path.startsWith('/us') ? 'en-US' : 'en';
// The brand suffix only when the whole thing still fits a result line (~60 chars): the operator
// and city at the end of a route title are what a rider scans for, and " | Headway" must not cut them off.
const fullTitle = /headway/i.test(title) ? title : (title.length + 11 <= 60 ? `${title} | Headway` : title);
const adsOn = import.meta.env.PUBLIC_ADS !== 'off';
const ga = import.meta.env.PUBLIC_GA_ID;
const ORG_ID = `${SITE}/#organization`;
const SITE_ID = `${SITE}/#website`;
const pageLd = {
  '@context': 'https://schema.org', '@type': pageType, '@id': `${canonical}#webpage`,
  url: canonical, name: fullTitle, description, inLanguage: lang,
  isPartOf: { '@id': SITE_ID }, publisher: { '@id': ORG_ID },
  ...(modified ? { dateModified: modified } : {}),
};
const entityLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': SITE_ID, name: 'Headway', url: `${SITE}/`, inLanguage: 'en', publisher: { '@id': ORG_ID }, potentialAction: { '@type': 'SearchAction', target: `${SITE}/search?q={q}`, 'query-input': 'required name=q' } },
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': ORG_ID, name: 'Headway', url: `${SITE}/`, logo: `${SITE}/favicon.svg`, email: 'zalashivraj2642003@gmail.com', founder: { '@type': 'Person', name: 'Shivrajsinh Zala', url: 'https://shivrajsinh.in' } },
];
const schema = [pageLd, ...jsonld, ...(path === '/' || path === '/about' ? entityLd : [])];
const NAV = [['Brisbane', 'au/brisbane'], ['Adelaide', 'au/adelaide'], ['Melbourne', 'au/melbourne-buses'], ['Victoria', 'au/vline-coaches'], ['Phoenix', 'us/phoenix']].filter(([, k]) => systems[k] && inNetwork(k).length);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <meta name="theme-color" content="#1B3FD1" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:site_name" content="Headway" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${SITE}/og.png`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${SITE}/og.png`} />
  {schema.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  {adsOn && <meta name="google-adsense-account" content="ca-pub-7164999486301748" />}
  {adsOn && <link rel="preconnect" href="https://pagead2.googlesyndication.com" />}
  {adsOn && <link rel="preconnect" href="https://googleads.g.doubleclick.net" crossorigin />}
  {adsOn && <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7164999486301748" crossorigin="anonymous"></script>}
  {ga && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>}
  {ga && <script is:inline define:vars={{ ga }}>window.dataLayer=window.dataLayer||[];window.gtag=function(){window.dataLayer.push(arguments)};window.gtag('js',new Date());window.gtag('config',ga);</script>}
</head>
<body>
  <a class="skip" href="#content">Skip to the times</a>
  <div class="band">
    <header class="container top google-anno-skip">
      <a class="brand" href="/" aria-label="Headway home"><Logo size={32} /><span>Headway</span></a>
      {nav ? (
        <nav class="top-nav" aria-label="Networks">{NAV.map(([name, k]) => <a href={`/${k}`}>{name}</a>)}</nav>
      ) : (
        <form class="top-search" action="/search" method="get" role="search" aria-label="Find a route, stop or town">
          <label class="visually-hidden" for="top-q">Route, stop or town</label>
          <input id="top-q" name="q" type="search" autocomplete="off" placeholder="Route, stop or town…" />
          <button type="submit" aria-label="Search">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
          </button>
        </form>
      )}
    </header>
    <slot name="hero" />
  </div>
  <main id="content" class="container page"><slot /></main>
  <slot name="after" />
  <footer class="container foot google-anno-skip">
    <p>Headway is independent and not affiliated with {operator || 'any operator'}. Times are published schedules, not live vehicle positions.</p>
    <nav aria-label="About">
      <a href="/about">About</a>
      <a href="/about#sources">Sources</a>
      <a href="/privacy">Privacy</a>
      <a href="https://transit.shivrajsinh.in" target="_blank" rel="noopener">Stopwatch Timetables</a>
      <a href="https://launchit.fast" target="_blank" rel="noopener" class="launchit-badge" style="display:inline-flex;align-items:center;vertical-align:middle;margin-left:8px;">
        <img src="https://launchit.fast/img/launching.svg" alt="Featured on LaunchIt" height="24" />
      </a>
    </nav>
  </footer>
  {adsOn && <script is:inline>
    (() => {
      const fill = (ins) => {
        if (!ins || ins.dataset.requested || !ins.offsetWidth) return false;
        ins.dataset.requested = '1';
        try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch { /* adblock */ }
        return true;
      };

      const setupSlots = () => {
        const slots = [...document.querySelectorAll('ins.adsbygoogle:not([data-adsbygoogle-status])')];
        if (!slots.length) return;
        if (!('IntersectionObserver' in window)) {
          slots.forEach(fill);
          return;
        }
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting && fill(e.target)) io.unobserve(e.target);
          }
        }, { rootMargin: '800px 0px' });
        slots.forEach((ins) => io.observe(ins));
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupSlots, { once: true });
      } else {
        setupSlots();
      }
    })();
  </script>}
</body>
</html>
